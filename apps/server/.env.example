PORT=5000
NODE_ENV=development
DEMO_ACCOUNTS_ENABLED=false
CLIENT_URL=http://localhost:5173

# Neon pooled connection — application runtime
DATABASE_URL="YOUR_NEON_POOLED_CONNECTION_STRING"

# Neon direct connection — Prisma migrations
DIRECT_URL="YOUR_NEON_DIRECT_CONNECTION_STRING"

# Authentication
JWT_ACCESS_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
JWT_REFRESH_SECRET="USE_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
OWNER_SETUP_SECRET="USE_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

TAX_RATE_PERCENT=0