
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  OWNER
  MANAGER
  CASHIER
  KITCHEN
  WAITER
}

enum DiningTableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  OUT_OF_SERVICE
}

enum DiningTableType {
  AC
  NON_AC
}

enum OrderStatus {
  OPEN
  SENT_TO_KITCHEN
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum KitchenTicketStatus {
  NEW
  PREPARING
  READY
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  WALLET
}

enum PaymentStatus {
  COMPLETED
  REFUNDED
  VOIDED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

// ============================================
// USER / AUTHENTICATION
// ============================================

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String

  role            UserRole  @default(CASHIER)

  employeeId      String?   @unique
  phone           String?

  isActive        Boolean   @default(true)

  refreshTokenHash String?
  lastLoginAt      DateTime?

  // Staff creation hierarchy
  createdById     String?
  createdBy       User?     @relation(
    "UserCreatedUsers",
    fields: [createdById],
    references: [id],
    onDelete: SetNull
  )

  createdUsers    User[]    @relation("UserCreatedUsers")

  // Orders created by this user
  orders          Order[]   @relation("OrderCreatedBy")

  // Payments received by this user
  paymentsReceived Payment[] @relation("PaymentReceivedBy")

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([role, isActive])
  @@index([createdById])
  @@map("users")
}

// ============================================
// MENU MANAGEMENT
// ============================================

model MenuCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?

  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)

  items       MenuItem[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([isActive, sortOrder])
}

model MenuItem {
  id                     String           @id @default(cuid())

  name                   String
  description            String?

  price                  Decimal          @db.Decimal(10, 2)

  imageUrl               String?
  imagePublicId          String?

  categoryId             String
  category               MenuCategory     @relation(
    fields: [categoryId],
    references: [id],
    onDelete: Restrict
  )

  // Kitchen station assignment
  kitchenStationId       String?
  kitchenStation         KitchenStation?  @relation(
    fields: [kitchenStationId],
    references: [id],
    onDelete: SetNull
  )

  isAvailable            Boolean          @default(true)

  preparationTimeMinutes Int              @default(10)
  sortOrder              Int              @default(0)

  orderItems             OrderItem[]

  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@unique([categoryId, name])
  @@index([categoryId, isAvailable])
  @@index([kitchenStationId])
  @@index([name])
}

// ============================================
// TABLE MANAGEMENT
// ============================================

model DiningTable {
  id          String             @id @default(cuid())

  tableNumber String             @unique
  name        String?

  capacity    Int                @default(2)

  section     String?

  type        DiningTableType    @default(AC)
  status      DiningTableStatus  @default(AVAILABLE)

  isActive    Boolean            @default(true)

  orders      Order[]

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status, isActive])
  @@index([section])
  @@index([type])
}

// ============================================
// ORDER MANAGEMENT
// ============================================

model Order {
  id              String       @id @default(cuid())

  orderNumber     String       @unique

  tableId         String
  table           DiningTable  @relation(
    fields: [tableId],
    references: [id],
    onDelete: Restrict
  )

  createdById     String
  createdBy       User         @relation(
    "OrderCreatedBy",
    fields: [createdById],
    references: [id],
    onDelete: Restrict
  )

  status          OrderStatus  @default(OPEN)

  subtotal        Decimal      @default(0) @db.Decimal(10, 2)
  discountAmount  Decimal      @default(0) @db.Decimal(10, 2)
  taxAmount       Decimal      @default(0) @db.Decimal(10, 2)
  total           Decimal      @default(0) @db.Decimal(10, 2)

  notes           String?

  completedAt     DateTime?
  cancelledAt     DateTime?

  items           OrderItem[]

  // Kitchen tickets
  kitchenTickets  KitchenTicket[]

  // Billing
  payments        Payment[]
  invoice         Invoice?
  discount        OrderDiscount?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([tableId, status])
  @@index([createdById, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id          String    @id @default(cuid())

  orderId     String
  order       Order     @relation(
    fields: [orderId],
    references: [id],
    onDelete: Cascade
  )

  menuItemId  String
  menuItem    MenuItem  @relation(
    fields: [menuItemId],
    references: [id],
    onDelete: Restrict
  )

  // Snapshot of menu information at order time
  itemName    String
  unitPrice   Decimal   @db.Decimal(10, 2)

  quantity    Int

  lineTotal   Decimal   @db.Decimal(10, 2)

  notes       String?

  kitchenTicketItems KitchenTicketItem[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([orderId])
  @@index([menuItemId])
}

// ============================================
// KITCHEN STATIONS
// ============================================

model KitchenStation {
  id          String          @id @default(cuid())

  name        String          @unique
  code        String          @unique

  isActive    Boolean         @default(true)

  menuItems   MenuItem[]
  tickets     KitchenTicket[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

// ============================================
// KOT / KITCHEN TICKETS
// ============================================

model KitchenTicket {
  id           String              @id @default(cuid())

  ticketNumber String              @unique

  orderId      String
  order        Order               @relation(
    fields: [orderId],
    references: [id],
    onDelete: Restrict
  )

  stationId    String
  station      KitchenStation      @relation(
    fields: [stationId],
    references: [id],
    onDelete: Restrict
  )

  status       KitchenTicketStatus @default(NEW)

  notes        String?

  startedAt    DateTime?
  readyAt      DateTime?

  items        KitchenTicketItem[]

  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([orderId, stationId])
  @@index([stationId, status, createdAt])
  @@index([orderId])
}

model KitchenTicketItem {
  id          String        @id @default(cuid())

  ticketId    String
  ticket      KitchenTicket @relation(
    fields: [ticketId],
    references: [id],
    onDelete: Cascade
  )

  orderItemId String
  orderItem   OrderItem     @relation(
    fields: [orderItemId],
    references: [id],
    onDelete: Restrict
  )

  // Snapshot of ordered item information
  itemName    String
  quantity    Int
  notes       String?

  createdAt   DateTime      @default(now())

  @@unique([ticketId, orderItemId])
}

// ============================================
// PAYMENT MANAGEMENT
// ============================================

model Payment {
  id              String        @id @default(cuid())

  paymentNumber   String        @unique

  orderId         String
  order           Order         @relation(
    fields: [orderId],
    references: [id],
    onDelete: Restrict
  )

  receivedById    String
  receivedBy      User          @relation(
    "PaymentReceivedBy",
    fields: [receivedById],
    references: [id],
    onDelete: Restrict
  )

  method          PaymentMethod
  status          PaymentStatus @default(COMPLETED)

  amount          Decimal       @db.Decimal(10, 2)

  reference       String?
  notes           String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([orderId, status])
  @@index([receivedById, createdAt])
  @@index([createdAt])
}

// ============================================
// INVOICES / RECEIPTS
// ============================================

model Invoice {
  id              String   @id @default(cuid())

  invoiceNumber   String   @unique

  orderId         String   @unique
  order           Order    @relation(
    fields: [orderId],
    references: [id],
    onDelete: Restrict
  )

  subtotal        Decimal  @db.Decimal(10, 2)
  discountAmount  Decimal  @default(0) @db.Decimal(10, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(10, 2)
  total           Decimal  @db.Decimal(10, 2)
  paidAmount      Decimal  @db.Decimal(10, 2)

  issuedAt        DateTime @default(now())

  @@index([issuedAt])
}

// ============================================
// ORDER DISCOUNTS
// ============================================

model OrderDiscount {
  id          String       @id @default(cuid())

  orderId     String       @unique
  order       Order        @relation(
    fields: [orderId],
    references: [id],
    onDelete: Cascade
  )

  type        DiscountType

  value       Decimal      @db.Decimal(10, 2)
  amount      Decimal      @db.Decimal(10, 2)

  reason      String

  appliedById String

  appliedAt   DateTime     @default(now())
}
